<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReelRoulette.LibraryArchive\ReelRoulette.LibraryArchive.csproj" />
    <ProjectReference Include="..\..\..\core\ReelRoulette.Core\ReelRoulette.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.13.0-dev.1</Version>
    <AssemblyName>ReelRoulette.DesktopApp</AssemblyName>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\..\..\assets\HI.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Suppress warnings for dialog windows that require constructor parameters -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <!-- No shipped or dev configuration is x86; VideoLAN.LibVLC.Windows enables both x64 and x86 copies by default because it keys off Platform (AnyCPU) rather than RuntimeIdentifier. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.9.7" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- License files -->
    <None Include="..\..\..\..\licenses\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\..\assets\HI-256.png" Link="HI-256.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\assets\HI-512.png" Link="HI-512.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\..\..\assets\HI.ico" Link="assets\HI.ico" />
    <AvaloniaResource Include="..\..\..\..\assets\fonts\MaterialSymbolsOutlined.var.ttf" Link="assets\fonts\MaterialSymbolsOutlined.var.ttf" />
  </ItemGroup>
</Project>