// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`opening and closing > keeps its markup on each tab > general 1`] = `
"<div class="filter-dialog" id="filter-dialog">
  <div class="filter-dialog-header">
    <h2 id="filter-dialog-heading">
      "Preset: Rich"
  <div aria-label="Filter sections" class="filter-dialog-tabstrip" role="tablist">
    <button aria-selected="true" class="tab text-tab filter-tab" data-filter-tab="general" role="tab" type="button">
      "General"
    <button aria-selected="false" class="tab text-tab filter-tab" data-filter-tab="tags" role="tab" type="button">
      "Tags"
    <button aria-selected="false" class="tab text-tab filter-tab" data-filter-tab="presets" role="tab" type="button">
      "Presets"
  <div class="filter-dialog-body themed-scrollbar">
    <div class="filter-panel" id="filter-panel-general" style="display: block">
      <div class="filter-section">
        <h3>
          "Basic Filters"
        <div class="filter-stack">
          <div class="mode-row">
            <label>
              <input checked="true" id="filter-fav" type="checkbox">
              "Favorites"
            <select aria-label="Favorites filter" class="ctl mode-select" id="filter-fav-mode">
              <option selected="true" value="only">
                "only"
              <option selected="false" value="excluded">
                "excluded"
          <div class="mode-row">
            <label>
              <input checked="true" id="filter-bl" type="checkbox">
              "Blacklisted"
            <span class="vfield vfield-after">
              <select aria-label="Blacklisted filter" class="ctl mode-select" id="filter-bl-mode">
                <option selected="false" value="only">
                  "only"
                <option selected="true" value="excluded">
                  "excluded"
          <label>
            <input checked="false" id="filter-never-played" type="checkbox">
            "Only never played"
          <label>
            <input checked="false" id="filter-known-dur" type="checkbox">
            "Only videos with known duration"
          <label>
            <input checked="false" id="filter-known-loud" type="checkbox">
            "Only videos with known loudness"
          <label>
            <input checked="false" id="filter-browser-playable" type="checkbox">
            "Only files this browser can play"
          <span class="vfield vfield-after">
            <label>
              <input checked="false" id="filter-unrated" type="checkbox">
              "Only unrated"
          <div class="mode-row min-rating-row">
            <span id="filter-min-rating-label">
              "Min Rating"
            <div aria-labelledby="filter-min-rating-label" aria-valuemax="5" aria-valuemin="0" aria-valuenow="0" aria-valuetext="No minimum" class="rating" role="slider">
              <span class="rating-star">
                <span aria-hidden="true" class="material-symbol-icon rating-outline">
                  "star"
                <span aria-hidden="true" class="material-symbol-icon is-filled rating-fill">
                  "star"
              <span class="rating-star">
                <span aria-hidden="true" class="material-symbol-icon rating-outline">
                  "star"
                <span aria-hidden="true" class="material-symbol-icon is-filled rating-fill">
                  "star"
              <span class="rating-star">
                <span aria-hidden="true" class="material-symbol-icon rating-outline">
                  "star"
                <span aria-hidden="true" class="material-symbol-icon is-filled rating-fill">
                  "star"
              <span class="rating-star">
                <span aria-hidden="true" class="material-symbol-icon rating-outline">
                  "star"
                <span aria-hidden="true" class="material-symbol-icon is-filled rating-fill">
                  "star"
              <span class="rating-star">
                <span aria-hidden="true" class="material-symbol-icon rating-outline">
                  "star"
                <span aria-hidden="true" class="material-symbol-icon is-filled rating-fill">
                  "star"
      <div class="filter-section">
        <h3>
          "Media Type"
        <div class="filter-stack">
          <label>
            <input checked="false" name="filter-media-type" type="radio" value="0">
            "All (Videos and Photos)"
          <label>
            <input checked="true" name="filter-media-type" type="radio" value="1">
            "Videos only"
          <label>
            <input checked="false" name="filter-media-type" type="radio" value="2">
            "Photos only"
      <div class="filter-section">
        <h3>
          "Sources (Client Filter)"
        <p class="filter-hint">
          "Checked sources are included. If all are checked, no source restriction is stored."
        <div class="filter-stack">
          <label>
            <input checked="true" data-source-id="source-1" id="filter-src-0" type="checkbox">
            "Movies (C:\\media\\movies)"
          <label>
            <input checked="false" data-source-id="source-2" id="filter-src-1" type="checkbox">
            "C:\\media\\photos"
          <label>
            <input checked="false" data-source-id="source-3" disabled="" id="filter-src-2" type="checkbox">
            "Archive (D:\\archive)"
      <div class="filter-section">
        <h3>
          "Audio Filter"
        <div class="filter-stack">
          <label>
            <input checked="false" name="filter-audio" type="radio" value="0">
            "All videos"
          <label>
            <input checked="false" name="filter-audio" type="radio" value="1">
            "Only videos with audio"
          <label>
            <input checked="true" name="filter-audio" type="radio" value="2">
            "Only videos without audio"
      <div class="filter-section">
        <h3>
          "Duration Filter"
        <div class="filter-stack duration-stack">
          <div class="filter-row">
            <span style="min-width: 3rem">
              "Min"
            <span class="vfield duration-field">
              <input aria-label="Minimum duration" autocomplete="off" class="ctl" id="filter-min-dur-text" placeholder="No minimum" type="text" value="01:30">
          <div class="filter-row">
            <span style="min-width: 3rem">
              "Max"
            <span class="vfield duration-field">
              <input aria-label="Maximum duration" autocomplete="off" class="ctl" id="filter-max-dur-text" placeholder="No maximum" type="text" value="01:01:40">
      <div class="filter-section">
        <h3>
          "Date Filter"
        <div class="filter-stack duration-stack">
          <div class="filter-row">
            <label class="date-label" for="filter-added">
              "Added"
            <select class="ctl date-choice" id="filter-added">
              <option selected="true" value="">
                "Any time"
              <option selected="false" value="last7Days">
                "Last 7 days"
              <option selected="false" value="last30Days">
                "Last 30 days"
              <option selected="false" value="last90Days">
                "Last 90 days"
              <option selected="false" value="thisYear">
                "This year"
              <option selected="false" value="custom">
                "Custom range"
          <div class="filter-row">
            <label class="date-label" for="filter-created">
              "Created"
            <select class="ctl date-choice" id="filter-created">
              <option selected="true" value="">
                "Any time"
              <option selected="false" value="last7Days">
                "Last 7 days"
              <option selected="false" value="last30Days">
                "Last 30 days"
              <option selected="false" value="last90Days">
                "Last 90 days"
              <option selected="false" value="thisYear">
                "This year"
              <option selected="false" value="custom">
                "Custom range"
    <div class="filter-panel" id="filter-panel-tags" style="display: none">
      <div class="filter-section">
        <h3>
          "Category Combination"
        <p class="filter-hint">
          "AND = all categories must match. OR = any category can match."
        <label class="filter-row">
          "Combine categories using:"
          <select class="ctl" id="filter-global-match">
            <option selected="false" value="and">
              "AND"
            <option selected="true" value="or">
              "OR"
      <div class="filter-section">
        <h3>
          "Tags Filter"
        <section class="tag-category">
          <div class="tag-category-header">
            <button aria-controls="filter-tag-grid-cat-places" aria-expanded="true" aria-label="Places, 1 tag in the filter" class="tag-category-toggle" title="Collapse category" type="button">
              <span class="tag-category-name">
                "Places"
              <span class="category-count" title="1 tag in the filter">
                "1"
              <span class="unsaved-dot category-dot" hidden="" title="Unsaved changes">
            <select aria-label="Match mode for Places" class="ctl filter-local-mode" data-cat-id="cat-places" title="Match mode">
              <option selected="true" value="0">
                "ALL (AND)"
              <option selected="false" value="1">
                "ANY (OR)"
          <div class="tag-grid" id="filter-tag-grid-cat-places">
            <div class="tag-chip">
              <span class="tag-chip-label">
                "alps"
              <button aria-label="Include alps" class="icon-btn" title="Include" type="button">
                <span class="material-symbol-icon">
                  "add"
              <button aria-label="Exclude alps" class="icon-btn" title="Exclude" type="button">
                <span class="material-symbol-icon">
                  "remove"
            <div class="tag-chip state-all">
              <span class="tag-chip-label">
                "Beach"
              <button aria-label="Include Beach" class="icon-btn is-selected" title="Include" type="button">
                <span class="material-symbol-icon">
                  "add"
              <button aria-label="Exclude Beach" class="icon-btn" title="Exclude" type="button">
                <span class="material-symbol-icon">
                  "remove"
        <section class="tag-category is-collapsed">
          <div class="tag-category-header">
            <button aria-controls="filter-tag-grid-cat-mood" aria-expanded="false" aria-label="Mood" class="tag-category-toggle" title="Expand category" type="button">
              <span class="tag-category-name">
                "Mood"
              <span class="category-count" hidden="" title="0 tags in the filter">
                "0"
              <span class="unsaved-dot category-dot" hidden="" title="Unsaved changes">
            <select aria-label="Match mode for Mood" class="ctl filter-local-mode" data-cat-id="cat-mood" title="Match mode">
              <option selected="true" value="0">
                "ALL (AND)"
              <option selected="false" value="1">
                "ANY (OR)"
          <div class="tag-grid" hidden="" id="filter-tag-grid-cat-mood">
            <div class="tag-chip">
              <span class="tag-chip-label">
                "Calm"
              <button aria-label="Include Calm" class="icon-btn" title="Include" type="button">
                <span class="material-symbol-icon">
                  "add"
              <button aria-label="Exclude Calm" class="icon-btn" title="Exclude" type="button">
                <span class="material-symbol-icon">
                  "remove"
        <section class="tag-category">
          <div class="tag-category-header">
            <button aria-controls="filter-tag-grid-cat-people" aria-expanded="true" aria-label="People, 1 tag in the filter" class="tag-category-toggle" title="Collapse category" type="button">
              <span class="tag-category-name">
                "People"
              <span class="category-count" title="1 tag in the filter">
                "1"
              <span class="unsaved-dot category-dot" hidden="" title="Unsaved changes">
            <select aria-label="Match mode for People" class="ctl filter-local-mode" data-cat-id="cat-people" title="Match mode">
              <option selected="false" value="0">
                "ALL (AND)"
              <option selected="true" value="1">
                "ANY (OR)"
          <div class="tag-grid" id="filter-tag-grid-cat-people">
            <div class="tag-chip">
              <span class="tag-chip-label">
                "Alice"
              <button aria-label="Include Alice" class="icon-btn" title="Include" type="button">
                <span class="material-symbol-icon">
                  "add"
              <button aria-label="Exclude Alice" class="icon-btn" title="Exclude" type="button">
                <span class="material-symbol-icon">
                  "remove"
            <div class="tag-chip state-none">
              <span class="tag-chip-label">
                "Bob"
              <button aria-label="Include Bob" class="icon-btn" title="Include" type="button">
                <span class="material-symbol-icon">
                  "add"
              <button aria-label="Exclude Bob" class="icon-btn is-selected" title="Exclude" type="button">
                <span class="material-symbol-icon">
                  "remove"
        <section class="tag-category">
          <div class="tag-category-header">
            <button aria-controls="filter-tag-grid-__filter_uncategorized__" aria-expanded="true" aria-label="Uncategorized, 1 tag in the filter" class="tag-category-toggle" title="Collapse category" type="button">
              <span class="tag-category-name">
                "Uncategorized"
              <span class="category-count" title="1 tag in the filter">
                "1"
              <span class="unsaved-dot category-dot" hidden="" title="Unsaved changes">
            <select aria-label="Match mode for Uncategorized" class="ctl filter-local-mode" data-cat-id="" title="Match mode">
              <option selected="true" value="0">
                "ALL (AND)"
              <option selected="false" value="1">
                "ANY (OR)"
          <div class="tag-grid" id="filter-tag-grid-__filter_uncategorized__">
            <div class="tag-chip state-all">
              <span class="tag-chip-label">
                "Ghost"
              <button aria-label="Include Ghost" class="icon-btn is-selected" title="Include" type="button">
                <span class="material-symbol-icon">
                  "add"
              <button aria-label="Exclude Ghost" class="icon-btn" title="Exclude" type="button">
                <span class="material-symbol-icon">
                  "remove"
    <div class="filter-panel" id="filter-panel-presets" style="display: none">
      <div class="filter-section">
        <h3>
          "Choose Preset"
        <div class="filter-row choose-preset-row">
          <select aria-label="Choose preset" class="ctl grow" id="filter-dialog-preset-select">
            <option selected="false" value="">
              "None"
            <option selected="true" value="preset-rich">
              "Rich"
            <option selected="false" value="preset-favorites">
              "Favorites"
          <button aria-label="Load preset" class="icon-btn" disabled="" id="filter-load-preset-btn" title="Load preset" type="button">
            <span class="material-symbol-icon">
              "sync"
          <button aria-describedby="P0-20" aria-label="Update preset" class="held-action icon-btn" disabled="" id="filter-update-preset-btn" title="Preset "Rich" already has this filter." type="button">
            <span class="btn-label">
              <span class="material-symbol-icon">
                "save"
          <span class="visually-hidden" id="P0-20">
            "Preset "Rich" already has this filter."
      <div class="filter-section">
        <h3>
          "Create New Preset From Current Filter"
        <div class="filter-row">
          <span class="vfield new-preset-field">
            <input aria-label="New preset name" autocomplete="off" class="ctl" id="filter-new-preset-name" placeholder="Enter preset name" type="text" value="">
          <button aria-describedby="P0-22" aria-label="Add preset" class="held-action icon-btn" disabled="" id="filter-add-preset-btn" title="Preset "Rich" already has this filter." type="button">
            <span class="btn-label">
              <span class="material-symbol-icon">
                "add"
          <span class="visually-hidden" id="P0-22">
            "Preset "Rich" already has this filter."
      <div class="filter-section filter-section-manage">
        <h3>
          "Manage Presets"
        <div class="filter-preset-list themed-scrollbar">
          <div class="filter-preset-row" data-preset-idx="0">
            <button aria-describedby="P0-19" aria-label="Reorder Rich" class="drag-handle" title="Drag to reorder" type="button">
              <span class="material-symbol-icon">
                "drag_indicator"
            <span class="filter-preset-name">
              "Rich"
            <button aria-label="Edit preset Rich" class="icon-btn" data-preset-edit="0" title="Edit preset" type="button">
              <span class="material-symbol-icon">
                "edit_note"
          <div class="filter-preset-row" data-preset-idx="1">
            <button aria-describedby="P0-19" aria-label="Reorder Favorites" class="drag-handle" title="Drag to reorder" type="button">
              <span class="material-symbol-icon">
                "drag_indicator"
            <span class="filter-preset-name">
              "Favorites"
            <button aria-label="Edit preset Favorites" class="icon-btn" data-preset-edit="1" title="Edit preset" type="button">
              <span class="material-symbol-icon">
                "edit_note"
        <p class="visually-hidden" id="P0-19">
          "Drag to reorder."
        <div aria-live="polite" class="visually-hidden">
  <div class="filter-dialog-footer">
    <button aria-label="Clear all filters" class="icon-btn" id="filter-clear-all-btn" title="Clear all filters" type="button">
      <span class="material-symbol-icon">
        "filter_alt_off"
    <button aria-label="Discard changes" class="icon-btn" disabled="" id="filter-discard-btn" title="Discard changes" type="button">
      <span class="material-symbol-icon">
        "undo"
    <button aria-label="Apply" class="held-action icon-btn" disabled="" id="filter-apply-btn" title="Apply" type="button">
      <span class="btn-label">
        <span class="material-symbol-icon">
          "save"
      <span class="unsaved-dot" hidden="">
"
`;

