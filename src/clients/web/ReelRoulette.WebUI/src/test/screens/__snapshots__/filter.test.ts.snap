            <span class="filter-preset-name">
              "Favorites"
            <button aria-label="Edit preset Favorites" class="icon-btn" data-preset-edit="1" title="Edit preset" type="button">
              <span class="material-symbol-icon">
                "edit_note"
        <p class="visually-hidden" id="P0-19">
          "Drag to reorder."
        <div aria-live="polite" class="visually-hidden">
  <div class="filter-dialog-footer">
    <button aria-label="Clear all filters" class="icon-btn" id="filter-clear-all-btn" title="Clear all filters" type="button">
      <span class="material-symbol-icon">
        "filter_alt_off"
    <button aria-label="Discard changes" class="icon-btn" disabled="" id="filter-discard-btn" title="Discard changes" type="button">
      <span class="material-symbol-icon">
        "undo"
    <button aria-label="Apply" class="held-action icon-btn" disabled="" id="filter-apply-btn" title="Apply" type="button">
      <span class="btn-label">
        <span class="material-symbol-icon">
          "save"
      <span class="unsaved-dot" hidden="">
"
`;
