          <div class="tag-autotag-row" data-autotag-row="0">
            <div class="tag-autotag-row-main">
              <button aria-label="Expand" class="icon-glyph-base icon-glyph-button" data-autotag-expand="0" type="button">
                <span class="material-symbol-icon">
                  "chevron_right"
              <input checked="false" data-autotag-row-check="0" type="checkbox">
              <span style="font-weight: 600">
                "Sunset"
              <span>
                "2"
              <span>
                "1"
            <div class="tag-autotag-row-files" style="display: none">
              <div class="tag-autotag-file-row">
                <label>
                  <input checked="false" data-autotag-file="" data-item-id="item-3" data-row-id="0" type="checkbox">
                <span class="tag-autotag-file-path" title="C:\\media\\sunset 1.mp4">
                  "sunset 1.mp4"
  <div class="tag-editor-footer">
    <button aria-label="Add category" class="icon-glyph-base icon-glyph-button" id="tag-editor-add-category-btn" title="Add category">
      <span class="material-symbol-icon">
        "add"
    <select id="tag-editor-category-select">
      <option selected="true" value="cat-places">
        "Places"
      <option selected="false" value="cat-mood">
        "Mood"
      <option selected="false" value="cat-people">
        "People"
      <option selected="false" value="uncategorized">
        "Uncategorized"
    <input id="tag-editor-new-tag" placeholder="New tag name" type="text" value="">
    <button aria-label="Add tag" class="icon-glyph-base icon-glyph-button" id="tag-editor-add-tag-btn" title="Add tag">
      <span class="material-symbol-icon">
        "add"
    <button aria-label="Save" class="icon-glyph-base icon-glyph-button has-pending" id="tag-editor-apply-btn" title="Save">
      <span class="material-symbol-icon">
        "save"
  <div class="tag-edit-modal" id="tag-edit-modal" style="display: none">
    <div class="tag-edit-modal-card">
      <h3>
        "Edit Tag"
      <label for="tag-edit-name">
        "Tag Name"
      <input autocomplete="off" id="tag-edit-name" type="text" value="Beach">
      <label for="tag-edit-category">
        "Category"
      <select id="tag-edit-category">
        <option selected="true" value="cat-places">
          "Places"
        <option selected="false" value="cat-mood">
          "Mood"
        <option selected="false" value="cat-people">
          "People"
        <option selected="false" value="uncategorized">
          "Uncategorized"
      <div class="tag-edit-modal-actions">
        <button id="tag-edit-cancel-btn" type="button">
          "Cancel"
        <button id="tag-edit-save-btn" type="button">
          "Save"
"
`;

