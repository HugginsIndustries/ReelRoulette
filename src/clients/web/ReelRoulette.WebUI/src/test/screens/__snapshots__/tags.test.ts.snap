// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`opening and closing > keeps its markup, and Auto Tag's and the Edit Tag dialog's > auto tag 1`] = `
"<dialog aria-labelledby="autotag-title" class="autotag-overlay" id="autotag" open="">
  <div class="autotag-head">
    <h2 id="autotag-title">
      "Auto Tag"
    <button aria-label="Close" class="icon-btn" id="autotag-close" title="Close" type="button">
      <span class="material-symbol-icon">
        "close"
  <div class="autotag-row">
    <label>
      <input checked="false" id="autotag-full" type="checkbox">
      "Scan full library"
    <label>
      <input checked="false" id="autotag-all" type="checkbox">
      "View all matches"
  <p class="filter-hint autotag-hint">
    "Use Scan Files to find matching tags. File name matching ignores extension."
  <div class="autotag-row">
    <button class="btn" id="autotag-select-all" type="button">
      "Select all"
    <button class="btn" id="autotag-deselect-all" type="button">
      "Deselect all"
    <button class="btn autotag-scan" id="autotag-scan" type="button">
      "Scan Files"
  <div aria-label="Scan in progress" class="autotag-progress" hidden="" id="autotag-progress" role="progressbar">
  <div aria-live="polite" class="autotag-status" id="autotag-status">
    "Scan complete: 3 matching tags, 6 matches, 1/3 selected changes."
  <div class="autotag-results themed-scrollbar" id="autotag-results">
    <div class="autotag-table-head">
      <span>
      <span>
        "Apply"
      <span>
        "Tag / File"
      <span class="autotag-count">
        "Total matched"
      <span class="autotag-count">
        "To be changed"
    <div class="autotag-result">
      <div class="autotag-row-main">
        <button aria-expanded="true" aria-label="Collapse" class="icon-btn" type="button">
          <span class="material-symbol-icon">
            "expand_more"
        <input aria-label="Apply beach" checked="false" type="checkbox">
        <span class="autotag-tag">
          "beach"
        <span class="autotag-count">
          "3"
        <span class="autotag-count">
          "2"
      <div class="autotag-files">
        <label class="autotag-file">
          <input checked="true" type="checkbox">
          <span title="C:\\media\\beach a.mp4">
            "beach a.mp4"
        <label class="autotag-file">
          <input checked="false" type="checkbox">
          <span title="C:\\media\\beach b.mp4">
            "beach b.mp4"
    <div class="autotag-result">
      <div class="autotag-row-main">
        <button aria-expanded="false" aria-label="Expand" class="icon-btn" type="button">
          <span class="material-symbol-icon">
            "chevron_right"
        <input aria-label="Apply Sunset" checked="false" type="checkbox">
        <span class="autotag-tag">
          "Sunset"
        <span class="autotag-count">
          "2"
        <span class="autotag-count">
          "1"
  <div class="autotag-footer">
    <button class="btn" id="autotag-cancel" type="button">
      "Cancel"
    <button class="btn" id="autotag-apply" type="button">
      "Apply"
"
`;

exports[`opening and closing > keeps its markup, and Auto Tag's and the Edit Tag dialog's > edit tag dialog 1`] = `
"<dialog aria-labelledby="P0-4" class="app-dialog" open="">
  <div class="dialog-body">
    <h3 id="P0-4">
      "Edit Tag"
    <label for="tag-edit-name">
      "Tag Name"
    <span class="vfield">
      <input autocomplete="off" id="tag-edit-name" type="text" value="Beach">
    <label for="tag-edit-category">
      "Category"
    <select id="tag-edit-category">
      <option selected="true" value="cat-places">
        "Places"
      <option selected="false" value="cat-mood">
        "Mood"
      <option selected="false" value="cat-people">
        "People"
      <option selected="false" value="uncategorized">
        "Uncategorized"
    <div class="dialog-actions">
      <button class="btn-danger" type="button">
        "Delete"
      <span class="dialog-spacer">
      <button type="button">
        "Cancel"
      <button class="held-action" id="tag-edit-save-btn" type="button">
        <span class="btn-label">
          "Save"
"
`;

exports[`opening and closing > keeps its markup, and Auto Tag's and the Edit Tag dialog's > edit tags 1`] = `
"<div class="tag-editor" id="tag-editor">
  <div class="tag-editor-header">
    <h2>
      "Tag Editor"
    <button aria-label="Auto Tag" class="icon-btn" id="tag-editor-autotag-btn" title="Auto Tag" type="button">
      <span class="material-symbol-icon">
        "auto_awesome"
    <button aria-label="Refresh" class="icon-btn" id="tag-editor-refresh-btn" title="Refresh" type="button">
      <span class="material-symbol-icon">
        "refresh"
  <p aria-live="polite" class="tags-target" hidden="" id="tag-editor-target">
  <div class="tag-editor-body themed-scrollbar" id="tag-editor-body">
    <section class="tag-category">
      <div class="tag-category-header">
        <button aria-describedby="P0-2" aria-label="Reorder Places" class="drag-handle" title="Drag to reorder" type="button">
          <span class="material-symbol-icon">
            "drag_indicator"
        <button aria-controls="tag-grid-cat-places" aria-expanded="true" aria-label="Places" class="tag-category-toggle" title="Collapse category" type="button">
          <span class="tag-category-name">
            "Places"
          <span class="category-count" hidden="" title="1 tag on this item">
            "1"
          <span class="unsaved-dot category-dot" hidden="" title="Unsaved changes">
        <button aria-label="Edit category Places" class="icon-btn" title="Edit category" type="button">
          <span class="material-symbol-icon">
            "edit_note"
      <div class="tag-grid" id="tag-grid-cat-places">
        <div class="tag-chip state-none">
          <span class="tag-chip-label">
            "alps"
          <button aria-label="Add tag alps" class="icon-btn is-selected" title="Add tag" type="button">
            <span class="material-symbol-icon">
              "add"
          <button aria-label="Remove tag alps" class="icon-btn" title="Remove tag" type="button">
            <span class="material-symbol-icon">
              "remove"
          <button aria-label="Edit tag alps" class="icon-btn" title="Edit tag" type="button">
            <span class="material-symbol-icon">
              "edit_note"
        <div class="tag-chip state-all">
          <span class="tag-chip-label">
            "Beach"
          <button aria-label="Add tag Beach" class="icon-btn" title="Add tag" type="button">
            <span class="material-symbol-icon">
              "add"
          <button aria-label="Remove tag Beach" class="icon-btn" title="Remove tag" type="button">
            <span class="material-symbol-icon">
              "remove"
          <button aria-label="Edit tag Beach" class="icon-btn" title="Edit tag" type="button">
            <span class="material-symbol-icon">
              "edit_note"
    <section class="tag-category is-collapsed">
      <div class="tag-category-header">
        <button aria-describedby="P0-2" aria-label="Reorder Mood" class="drag-handle" title="Drag to reorder" type="button">
          <span class="material-symbol-icon">
            "drag_indicator"
        <button aria-controls="tag-grid-cat-mood" aria-expanded="false" aria-label="Mood" class="tag-category-toggle" title="Expand category" type="button">
          <span class="tag-category-name">
            "Mood"
          <span class="category-count" hidden="" title="0 tags on this item">
            "0"
          <span class="unsaved-dot category-dot" hidden="" title="Unsaved changes">
        <button aria-label="Edit category Mood" class="icon-btn" title="Edit category" type="button">
          <span class="material-symbol-icon">
            "edit_note"
      <div class="tag-grid" hidden="" id="tag-grid-cat-mood">
        <div class="tag-chip state-none">
          <span class="tag-chip-label">
            "Calm"
          <button aria-label="Add tag Calm" class="icon-btn" title="Add tag" type="button">
            <span class="material-symbol-icon">
              "add"
          <button aria-label="Remove tag Calm" class="icon-btn" title="Remove tag" type="button">
            <span class="material-symbol-icon">
              "remove"
          <button aria-label="Edit tag Calm" class="icon-btn" title="Edit tag" type="button">
            <span class="material-symbol-icon">
              "edit_note"
    <section class="tag-category">
      <div class="tag-category-header">
        <button aria-describedby="P0-2" aria-label="Reorder People" class="drag-handle" title="Drag to reorder" type="button">
          <span class="material-symbol-icon">
            "drag_indicator"
        <button aria-controls="tag-grid-cat-people" aria-expanded="true" aria-label="People" class="tag-category-toggle" title="Collapse category" type="button">
          <span class="tag-category-name">
            "People"
          <span class="category-count" hidden="" title="1 tag on this item">
            "1"
          <span class="unsaved-dot category-dot" hidden="" title="Unsaved changes">
        <button aria-label="Edit category People" class="icon-btn" title="Edit category" type="button">
          <span class="material-symbol-icon">
            "edit_note"
      <div class="tag-grid" id="tag-grid-cat-people">
        <div class="tag-chip state-none">
          <span class="tag-chip-label">
            "Alice"
          <button aria-label="Add tag Alice" class="icon-btn" title="Add tag" type="button">
            <span class="material-symbol-icon">
              "add"
          <button aria-label="Remove tag Alice" class="icon-btn" title="Remove tag" type="button">
            <span class="material-symbol-icon">
              "remove"
          <button aria-label="Edit tag Alice" class="icon-btn" title="Edit tag" type="button">
            <span class="material-symbol-icon">
              "edit_note"
        <div class="tag-chip state-all">
          <span class="tag-chip-label">
            "Bob"
          <button aria-label="Add tag Bob" class="icon-btn" title="Add tag" type="button">
            <span class="material-symbol-icon">
              "add"
          <button aria-label="Remove tag Bob" class="icon-btn is-selected" title="Remove tag" type="button">
            <span class="material-symbol-icon">
              "remove"
          <button aria-label="Edit tag Bob" class="icon-btn" title="Edit tag" type="button">
            <span class="material-symbol-icon">
              "edit_note"
    <section class="tag-category">
      <div class="tag-category-header">
        <button aria-label="Uncategorized stays last" class="drag-handle" disabled="" title="Uncategorized stays last" type="button">
          <span class="material-symbol-icon">
            "drag_indicator"
        <button aria-controls="tag-grid-uncategorized" aria-expanded="true" aria-label="Uncategorized" class="tag-category-toggle" title="Collapse category" type="button">
          <span class="tag-category-name">
            "Uncategorized"
          <span class="category-count" hidden="" title="0 tags on this item">
            "0"
          <span class="unsaved-dot category-dot" hidden="" title="Unsaved changes">
      <div class="tag-grid" id="tag-grid-uncategorized">
        <div class="tag-chip state-none">
          <span class="tag-chip-label">
            "Loose"
          <button aria-label="Add tag Loose" class="icon-btn" title="Add tag" type="button">
            <span class="material-symbol-icon">
              "add"
          <button aria-label="Remove tag Loose" class="icon-btn" title="Remove tag" type="button">
            <span class="material-symbol-icon">
              "remove"
          <button aria-label="Edit tag Loose" class="icon-btn" title="Edit tag" type="button">
            <span class="material-symbol-icon">
              "edit_note"
  <p class="visually-hidden" id="P0-2">
    "Drag to reorder, or press the up and down arrow keys."
  <div aria-live="polite" class="visually-hidden">
  <div class="tag-editor-footer">
    <div class="tag-editor-footer-row">
      <button aria-label="Add category" class="icon-btn" id="tag-editor-add-category-btn" title="Add category" type="button">
        <span class="material-symbol-icon">
          "add"
      <select aria-label="Category for new tag" class="ctl" id="tag-editor-category-select">
        <option selected="true" value="cat-places">
          "Places"
        <option selected="false" value="cat-mood">
          "Mood"
        <option selected="false" value="cat-people">
          "People"
        <option selected="false" value="uncategorized">
          "Uncategorized"
    <div class="tag-editor-footer-row">
      <span class="vfield">
        <input aria-label="New tag name" autocomplete="off" class="ctl" id="tag-editor-new-tag" placeholder="New tag name" type="text" value="">
      <button aria-label="Add tag" class="icon-btn" disabled="" id="tag-editor-add-tag-btn" title="Add tag" type="button">
        <span class="material-symbol-icon">
          "add"
      <button aria-label="Save" class="icon-btn has-pending" id="tag-editor-apply-btn" title="Save" type="button">
        <span class="material-symbol-icon">
          "save"
"
`;
