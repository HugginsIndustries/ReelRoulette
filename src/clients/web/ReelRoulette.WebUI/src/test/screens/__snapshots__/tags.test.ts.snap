exports[`opening and closing > keeps its markup on each tab and in the Edit Tag dialog > edit tag dialog 1`] = `
"<dialog aria-labelledby="P0-3" class="app-dialog" open="">
  <div class="dialog-body">
    <h3 id="P0-3">
      "Edit Tag"
    <label for="tag-edit-name">
      "Tag Name"
    <span class="vfield">
      <input autocomplete="off" id="tag-edit-name" type="text" value="Beach">
    <label for="tag-edit-category">
      "Category"
    <select id="tag-edit-category">
      <option selected="true" value="cat-places">
        "Places"
      <option selected="false" value="cat-mood">
        "Mood"
      <option selected="false" value="cat-people">
        "People"
      <option selected="false" value="uncategorized">
        "Uncategorized"
    <div class="dialog-actions">
      <button class="btn-danger" type="button">
        "Delete"
      <span class="dialog-spacer">
      <button type="button">
        "Cancel"
      <button class="held-action" id="tag-edit-save-btn" type="button">
        <span class="btn-label">
          "Save"
"
`;

