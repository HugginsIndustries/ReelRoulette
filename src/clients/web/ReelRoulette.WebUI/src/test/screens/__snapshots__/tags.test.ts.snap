              <button class="tag-editor-category-btn icon-glyph-base icon-glyph-button" disabled="" title="Rename category">
                <span class="material-symbol-icon">
                  "edit_note"
              <button class="tag-editor-category-btn icon-glyph-base icon-glyph-button" disabled="" title="Delete category">
                <span class="material-symbol-icon">
                  "delete"
          <div class="tag-editor-tag-grid">
            <div class="tag-chip state-none">
              <span class="tag-chip-label">
                "Loose"
              <button class="chip-btn icon-glyph-base icon-glyph-toggle" title="Add tag">
                <span class="material-symbol-icon">
                  "add"
              <button class="chip-btn icon-glyph-base icon-glyph-toggle" title="Remove tag">
                <span class="material-symbol-icon">
                  "remove"
              <button class="chip-btn icon-glyph-base icon-glyph-button" title="Edit tag">
                <span class="material-symbol-icon">
                  "edit_note"
              <button class="chip-btn icon-glyph-base icon-glyph-button" title="Delete tag">
                <span class="material-symbol-icon">
                  "delete"
    <div class="tag-editor-panel" id="tag-editor-panel-autotag" style="display: none">
      <div class="tag-editor-body tag-autotag-body themed-scrollbar">
        <div class="tag-autotag-toolbar">
          <label class="tag-autotag-check-label">
            <input checked="false" id="tag-autotag-scan-full" type="checkbox">
            "Scan full library"
          <label class="tag-autotag-check-label">
            <input checked="false" id="tag-autotag-view-all" type="checkbox">
            "View all matches"
        <p class="tag-autotag-hint">
          "Use Scan Files to find matching tags. File name matching ignores extension."
        <div class="tag-autotag-actions-row">
          <button class="tag-autotag-row-btn" id="tag-autotag-select-all" type="button">
            "Select all"
          <button class="tag-autotag-row-btn" id="tag-autotag-deselect-all" type="button">
            "Deselect all"
          <button class="tag-autotag-scan-btn" id="tag-autotag-scan-btn" type="button">
            "Scan Files"
        <div aria-label="Scan in progress" class="tag-autotag-progress" id="tag-autotag-progress" role="progressbar" style="display: none">
        <div aria-live="polite" class="tag-autotag-status" id="tag-autotag-status">
        <div class="tag-autotag-results themed-scrollbar" id="tag-autotag-results">
  <div class="tag-editor-footer">
    <button aria-label="Add category" class="icon-glyph-base icon-glyph-button" id="tag-editor-add-category-btn" title="Add category">
      <span class="material-symbol-icon">
        "add"
    <select id="tag-editor-category-select">
      <option selected="true" value="cat-places">
        "Places"
      <option selected="false" value="cat-mood">
        "Mood"
      <option selected="false" value="cat-people">
        "People"
      <option selected="false" value="uncategorized">
        "Uncategorized"
    <input id="tag-editor-new-tag" placeholder="New tag name" type="text" value="">
    <button aria-label="Add tag" class="icon-glyph-base icon-glyph-button" id="tag-editor-add-tag-btn" title="Add tag">
      <span class="material-symbol-icon">
        "add"
    <button aria-label="Save" class="icon-glyph-base icon-glyph-button has-pending" id="tag-editor-apply-btn" title="Save">
      <span class="material-symbol-icon">
        "save"
  <div class="tag-edit-modal" id="tag-edit-modal" style="display: none">
    <div class="tag-edit-modal-card">
      <h3>
        "Edit Tag"
      <label for="tag-edit-name">
        "Tag Name"
      <input autocomplete="off" id="tag-edit-name" type="text" value="">
      <label for="tag-edit-category">
        "Category"
      <select id="tag-edit-category">
      <div class="tag-edit-modal-actions">
        <button id="tag-edit-cancel-btn" type="button">
          "Cancel"
        <button id="tag-edit-save-btn" type="button">
          "Save"
"
`;
