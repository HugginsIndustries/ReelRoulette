exports[`overlay > keeps its markup while loading, with tiles, and when a query fails > error 1`] = `
"<div class="library-overlay" id="library-overlay">
  <div class="library-overlay-header">
    <h2>
      "Library"
    <p aria-live="polite" class="library-overlay-summary" hidden="" id="library-overlay-summary">
      <span aria-hidden="true">
      <span class="visually-hidden">
    <button aria-controls="library-filter-summary library-controls" aria-expanded="true" aria-label="Hide library controls and filters" class="icon-glyph-base icon-glyph-button library-controls-toggle" id="library-controls-toggle" title="Hide controls & filters" type="button">
      <span aria-hidden="true" class="material-symbol-icon">
        "unfold_less"
  <button class="library-filter-summary" hidden="" id="library-filter-summary" title="Open the Filter tab" type="button">
    <b>
      "Filters:"
  <div class="library-controls" id="library-controls">
    <div class="library-controls-pair">
      <select aria-label="Choose preset" id="preset-select">
        <option value="">
          "None"
      <select aria-label="Choose randomization mode" id="randomization-mode-select">
        <option value="SmartShuffle">
          "Smart Shuffle"
        <option value="PureRandom">
          "Pure Random"
        <option value="WeightedRandom">
          "Weighted Random"
        <option value="SpreadMode">
          "Spread Mode"
        <option value="WeightedWithSpread">
          "Weighted with Spread"
    <div class="library-controls-sort">
      <select aria-label="Sort library" class="library-overlay-sort-select" id="library-sort-select">
        <option value="Name">
          "Name"
        <option value="LastPlayed">
          "Last played"
        <option value="PlayCount">
          "Play count"
        <option value="Duration">
          "Duration"
        <option value="DateAdded">
          "Date added"
      <button aria-label="Toggle sort direction" class="library-overlay-sort-direction" id="library-sort-direction-btn" type="button">
        "A–Z"
    <input aria-label="Search library" autocomplete="off" class="library-overlay-search" id="library-search-input" placeholder="Search…" type="search">
  <div class="library-overlay-body" id="library-overlay-body">
    <p class="library-overlay-status library-overlay-status-error" role="alert">
      "Library load failed."
"
`;

