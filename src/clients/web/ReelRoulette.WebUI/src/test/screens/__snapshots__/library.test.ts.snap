    <button aria-label="Hide library controls and filters" class="icon-glyph-base icon-glyph-button library-controls-toggle" id="library-controls-toggle" title="Hide controls & filters" type="button">
      <span aria-hidden="true" class="material-symbol-icon">
        "unfold_less"
  <button class="library-line" hidden="" id="library-filter-summary" title="Open the Filter tab" type="button">
