exports[`overlay > keeps its markup while loading, with tiles, and when a query fails > error 1`] = `
"<div class="library-overlay" id="library-overlay">
  <div class="library-overlay-header">
    <h2>
      "Library"
    <p class="library-overlay-summary" hidden="" id="library-overlay-summary">
    <button aria-label="Hide library controls and filters" class="icon-btn" id="library-controls-toggle" title="Hide controls & filters" type="button">
      <span aria-hidden="true" class="material-symbol-icon">
        "unfold_less"
  <button class="library-line" hidden="" id="library-filter-summary" title="Open the Filter tab" type="button">
    <span class="library-line-text">
      <b>
        "Filters:"
    <span class="material-symbol-icon library-line-chevron">
      "chevron_right"
  <button class="library-line" id="library-random-line" title="Open the Randomization tab" type="button">
    <span class="library-line-text">
      <b>
        "Random:"
      "Shuffle · Spread by folder"
    <span class="material-symbol-icon library-line-chevron">
      "chevron_right"
  <div class="library-controls" id="library-controls">
    <div class="library-controls-pair">
      <div class="library-preset-field">
        <select aria-label="Choose preset" class="ctl" id="preset-select">
          <option value="">
            "None"
        <span class="library-preset-label">
          "Preset:"
      <input aria-label="Search library" autocomplete="off" class="ctl" id="library-search-input" placeholder="Search…" type="search">
    <div class="library-controls-sort">
      <select aria-label="Sort library" class="ctl" id="library-sort-select">
        <option value="Name">
          "Name"
        <option value="LastPlayed">
          "Last played"
        <option value="PlayCount">
          "Play count"
        <option value="Duration">
          "Duration"
        <option value="DateAdded">
          "Date added"
        <option value="DateCreated">
          "Date created"
        <option value="Rating">
          "Rating"
      <button aria-label="Toggle sort direction" class="btn library-overlay-sort-direction" id="library-sort-direction-btn" type="button">
        "A–Z"
  <div class="library-overlay-body" id="library-overlay-body">
    <p class="library-overlay-status library-overlay-status-error">
      "Library load failed."
"
`;

