                    <kbd>
                      "Shift+F"
                  <dd>
                    "Fullscreen"
                  <dt>
                    <kbd>
                      "H"
                  <dd>
                    "These shortcuts"
                  <dt>
                    <kbd>
                      "Esc"
                  <dd>
                    "Close the top dialog, the notifications list, the rating stars, or the panel, or leave fullscreen"
                <p class="setting-hint">
                  "Shortcuts do nothing while you type in a text field."
            <section aria-labelledby="settings-diagnostics-heading" class="settings-section">
              <h3 id="settings-diagnostics-heading">
                "Diagnostics"
              <dl class="diag">
                <dt>
                  "Client"
                <dd>
                  "…"
                <dt>
                  "Session"
                <dd>
                  "…"
                <dt>
                  "Client type"
                <dd>
                  "…"
                <dt>
                  "Device name"
                <dd>
                  "…"
                <dt>
                  "Server"
                <dd>
                  "…"
                <dt>
                  "ReelRoulette"
                <dd>
                  "…"
            <p class="setting-hint">
              "Settings apply at once and are kept on this device."
    <section aria-labelledby="notify-title" class="notify-list" hidden="" id="notify-list" role="dialog">
      <div class="notify-head">
        <h2 id="notify-title" tabindex="-1">
          "Notifications"
        <button class="btn" data-act="clear" disabled="" type="button">
          "Clear"
        <button aria-label="Close" class="icon-btn" data-act="close" title="Close" type="button">
          <span class="material-symbol-icon">
            "close"
      <div class="notify-scroll themed-scrollbar">
        <div data-part="now" hidden="">
          <h3 class="notify-group-title">
            "Now"
          <ul class="notify-entries">
        <div data-part="recent">
          <h3 class="notify-group-title" hidden="">
            "Recent"
          <ul class="notify-entries">
          <p class="notify-empty">
            "No notifications yet."
      <div class="notify-foot">
        <button class="btn" data-act="settings" type="button">
          <span aria-hidden="true" class="material-symbol-icon">
            "settings"
          "Notification settings"
"
`;
