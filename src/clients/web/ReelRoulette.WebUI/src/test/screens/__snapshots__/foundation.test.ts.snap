// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`page structure > keeps the starting markup 1`] = `
"<div id="app">
  <header class="top-bar">
    <h1 class="brand">
      <img alt="ReelRoulette" class="brand-on-dark" src="/icons/logo-lockup.svg">
      <img alt="ReelRoulette" class="brand-on-light" src="/icons/logo-lockup-dark.svg">
      <img alt="ReelRoulette" class="brand-icon" src="/icons/logo-icon.svg">
    <div class="pair-section" id="pair-section" style="display: none">
      <label class="pair-section-label">
        <span class="pair-section-label-hint">
          "Pairing token"
        <input id="pair-token" placeholder="Enter token" type="text">
      <button class="held-action" disabled="" id="pair-btn" type="button">
        <span class="btn-label">
          "Pair"
    <div class="now-playing" id="now-playing" style="display: none">
      <span class="is-link" id="now-playing-name" role="button" tabindex="0">
      <span class="muted" id="now-playing-duration">
  <div class="fullscreen-stage" data-panel-mode="side" data-side="right" id="fullscreen-stage" style="--panel-width: 420px">
    <main class="player-col">
      <div class="media-container controls-visible" id="media-container">
        <div aria-hidden="true" class="ambient" hidden="" id="ambient" style="--ambient-blur: 64px; --ambient-dark: 0.5; --ambient-light: 0.75; --ambient-saturation: 1">
          <canvas height="18" width="32">
        <video disablepictureinpicture="" disableremoteplayback="" id="video" playsinline="" preload="auto" style="display: none" webkit-playsinline="">
        <img alt="Photo" id="photo" style="display: none">
        <div class="empty-state" id="empty-state">
          "Tap to play, or open the panel to choose a preset or filter."
        <div aria-live="polite" class="player-indicator-region" id="player-indicator" role="status">
        <div aria-hidden="true" class="volume-indicator" id="volume-indicator">
          <span class="material-symbol-icon">
            "volume_up"
          <span id="volume-indicator-text">
            "100%"
        <div aria-hidden="true" class="seek-indicator is-back" id="seek-indicator-back">
          <span class="material-symbol-icon">
            "chevron_left"
          <span class="seek-indicator-text">
        <div aria-hidden="true" class="seek-indicator is-forward" id="seek-indicator-forward">
          <span class="seek-indicator-text">
          <span class="material-symbol-icon">
            "chevron_right"
        <div class="overlay-controls" id="overlay-controls">
          <button aria-controls="notify-list" aria-expanded="false" aria-label="Notifications" class="overlay-btn icon-glyph-base icon-glyph-button overlay-corner-btn notify-btn" id="notify-btn" title="Notifications" type="button">
            <span class="material-symbol-icon">
              "notifications"
            <span class="notify-badge" hidden="">
              "0"
          <button aria-controls="panel" aria-expanded="false" aria-label="Open panel" class="overlay-btn icon-glyph-base icon-glyph-toggle overlay-toggle overlay-corner-btn" id="panel-btn" title="Open panel">
            <span class="material-symbol-icon">
              "right_panel_open"
            <span class="unsaved-dot" hidden="">
          <button aria-controls="rating-popover" aria-expanded="false" aria-label="Rating" class="overlay-btn icon-glyph-base icon-glyph-toggle overlay-toggle overlay-corner-btn" id="rating-btn" title="Rating" type="button">
            <span class="material-symbol-icon">
              "star"
            <span aria-hidden="true" class="rating-badge" hidden="">
          <div class="rating-popover" hidden="" id="rating-popover">
          <button aria-label="Favorite" class="overlay-btn icon-glyph-base icon-glyph-toggle overlay-toggle overlay-corner-btn" id="favorite-btn" title="Favorite">
            <span class="material-symbol-icon">
              "favorite"
          <button aria-label="Blacklist" class="overlay-btn icon-glyph-base icon-glyph-toggle overlay-toggle overlay-corner-btn" id="blacklist-btn" title="Blacklist">
            <span class="material-symbol-icon">
              "thumb_down"
          <div class="overlay-controls-row overlay-controls-transport">
            <button aria-label="Previous" class="overlay-btn icon-glyph-base icon-glyph-button" id="prev-btn" title="Previous">
              <span class="material-symbol-icon">
                "skip_previous"
            <button aria-label="Play/Pause" class="overlay-btn icon-glyph-base icon-glyph-button overlay-btn-play" id="play-btn" title="Play/Pause">
              <span class="material-symbol-icon">
                "play_arrow"
            <button aria-label="Next" class="overlay-btn icon-glyph-base icon-glyph-button" id="next-btn" title="Next">
              <span class="material-symbol-icon">
                "skip_next"
            <button aria-label="Random" class="overlay-btn icon-glyph-base icon-glyph-button" id="random-btn" title="Random">
              <span class="material-symbol-icon">
                "casino"
            <button aria-label="Loop" class="overlay-btn icon-glyph-base icon-glyph-toggle overlay-toggle" id="loop-btn" title="Loop">
              <span class="material-symbol-icon">
                "repeat_one"
            <button aria-label="Autoplay" class="overlay-btn icon-glyph-base icon-glyph-toggle overlay-toggle" id="autoplay-btn" title="Autoplay">
              <span class="material-symbol-icon">
                "autoplay"
            <button aria-label="Fullscreen" class="overlay-btn icon-glyph-base icon-glyph-button" id="fullscreen-btn" title="Fullscreen">
              <span class="material-symbol-icon">
                "fullscreen"
          <div class="overlay-seek-row" id="seek-row">
            <span class="seek-wrap" id="seek-wrap">
              <span aria-hidden="true" class="seek-loop" hidden="" id="seek-loop">
              <input aria-label="Seek" disabled="" id="seek-slider" max="100" min="0" step="any" type="range" value="0">
            <span id="time-display">
              "0:00 / 0:00"
            <button aria-label="Mute" class="overlay-btn icon-glyph-base icon-glyph-toggle overlay-toggle" id="mute-btn" title="Mute">
              <span class="material-symbol-icon">
                "volume_up"
            <span class="volume" id="volume-wrap">
              <input aria-label="Volume" id="volume-slider" max="100" min="0" step="1" title="Volume" type="range">
      <div aria-live="polite" class="toasts" data-pos="bottom-center" id="toasts" role="status">
    <div aria-controls="panel" aria-label="Resize panel" aria-orientation="vertical" aria-valuemax="612" aria-valuemin="360" aria-valuenow="420" aria-valuetext="420 pixels" class="panel-handle" hidden="" id="panel-handle" role="separator" tabindex="0">
      <span class="handle-grip">
    <aside aria-label="Panel" class="panel" hidden="" id="panel">
      <div class="panel-tabs">
        <div aria-label="Panel tabs" class="panel-tablist" role="tablist">
          <button aria-controls="panel-page-library" aria-label="Library" aria-selected="true" class="tab panel-tab" id="panel-tab-library" role="tab" title="Library" type="button">
            <span class="material-symbol-icon">
              "browse"
          <button aria-controls="panel-page-tags" aria-label="Tags" aria-selected="false" class="tab panel-tab" id="panel-tab-tags" role="tab" title="Tags" type="button">
            <span class="material-symbol-icon">
              "tag"
            <span class="unsaved-dot" hidden="">
          <button aria-controls="panel-page-stats" aria-label="Stats" aria-selected="false" class="tab panel-tab" id="panel-tab-stats" role="tab" title="Stats" type="button">
            <span class="material-symbol-icon">
              "bar_chart"
          <button aria-controls="panel-page-filter" aria-label="Filter" aria-selected="false" class="tab panel-tab" id="panel-tab-filter" role="tab" title="Filter" type="button">
            <span class="material-symbol-icon">
              "filter_alt"
            <span class="unsaved-dot" hidden="">
          <button aria-controls="panel-page-randomization" aria-label="Randomization" aria-selected="false" class="tab panel-tab" id="panel-tab-randomization" role="tab" title="Randomization" type="button">
            <span class="material-symbol-icon">
              "casino"
          <button aria-controls="panel-page-settings" aria-label="Settings" aria-selected="false" class="tab panel-tab" id="panel-tab-settings" role="tab" title="Settings" type="button">
            <span class="material-symbol-icon">
              "settings"
        <span class="panel-tabs-spacer">
        <button aria-label="Close panel" class="icon-glyph-base icon-glyph-button panel-close" id="panel-close-btn" title="Close" type="button">
          <span class="material-symbol-icon">
            "close"
      <section aria-labelledby="panel-tab-library" class="panel-page" hidden="" id="panel-page-library" role="tabpanel">
        <div class="library-overlay" id="library-overlay">
          <div class="library-overlay-header">
            <h2>
              "Library"
            <p aria-live="polite" class="library-overlay-summary" hidden="" id="library-overlay-summary">
              <span aria-hidden="true">
              <span class="visually-hidden">
            <button aria-controls="library-filter-summary library-random-line library-controls" aria-expanded="true" aria-label="Hide library controls and filters" class="icon-glyph-base icon-glyph-button library-controls-toggle" id="library-controls-toggle" title="Hide controls & filters" type="button">
              <span aria-hidden="true" class="material-symbol-icon">
                "unfold_less"
          <button class="library-line" hidden="" id="library-filter-summary" title="Open the Filter tab" type="button">
            <b>
              "Filters:"
          <button class="library-line" id="library-random-line" title="Open the Randomization tab" type="button">
            <b>
              "Random:"
            "Shuffle · Spread by folder"
          <div class="library-controls" id="library-controls">
            <div class="library-controls-pair">
              <select aria-label="Choose preset" id="preset-select">
                <option value="">
                  "None"
              <input aria-label="Search library" autocomplete="off" class="library-overlay-search" id="library-search-input" placeholder="Search…" type="search">
            <div class="library-controls-sort">
              <select aria-label="Sort library" class="library-overlay-sort-select" id="library-sort-select">
                <option value="Name">
                  "Name"
                <option value="LastPlayed">
                  "Last played"
                <option value="PlayCount">
                  "Play count"
                <option value="Duration">
                  "Duration"
                <option value="DateAdded">
                  "Date added"
                <option value="DateCreated">
                  "Date created"
                <option value="Rating">
                  "Rating"
              <button aria-label="Toggle sort direction" class="library-overlay-sort-direction" id="library-sort-direction-btn" type="button">
                "A–Z"
          <div class="library-overlay-body" id="library-overlay-body">
      <section aria-labelledby="panel-tab-tags" class="panel-page" hidden="" id="panel-page-tags" role="tabpanel">
        <div class="tag-editor" id="tag-editor">
          <div class="tag-editor-header">
            <h2>
              "Tag Editor"
            <button aria-label="Auto Tag" class="icon-btn" id="tag-editor-autotag-btn" title="Auto Tag" type="button">
              <span class="material-symbol-icon">
                "auto_awesome"
          <p aria-live="polite" class="tags-target" hidden="" id="tag-editor-target">
          <div class="tag-editor-body themed-scrollbar" id="tag-editor-body">
          <div class="tag-editor-footer">
            <div class="tag-editor-footer-row">
              <button aria-label="Add category" class="icon-btn" id="tag-editor-add-category-btn" title="Add category" type="button">
                <span class="material-symbol-icon">
                  "add"
              <select aria-label="Category for new tag" class="ctl" id="tag-editor-category-select">
            <div class="tag-editor-footer-row">
              <span class="vfield">
                <input aria-label="New tag name" autocomplete="off" class="ctl" id="tag-editor-new-tag" placeholder="New tag name" type="text">
              <button aria-label="Add tag" class="icon-btn" disabled="" id="tag-editor-add-tag-btn" title="Add tag" type="button">
                <span class="material-symbol-icon">
                  "add"
              <button aria-label="Discard changes" class="icon-btn" disabled="" id="tag-editor-discard-btn" title="Discard changes" type="button">
                <span class="material-symbol-icon">
                  "undo"
              <button aria-label="Save" class="icon-btn" id="tag-editor-apply-btn" title="Save" type="button">
                <span class="material-symbol-icon">
                  "save"
                <span class="unsaved-dot" hidden="">
      <section aria-labelledby="panel-tab-stats" class="panel-page" hidden="" id="panel-page-stats" role="tabpanel">
        <div class="stats-tab" id="stats-tab">
          <div class="stats-tab-header">
            <h2>
              "Stats"
            <button aria-label="Show exact times" class="icon-btn" id="stats-exact-times-btn" title="Show exact times" type="button">
              <span aria-hidden="true" class="material-symbol-icon">
                "calendar_clock"
          <div class="stats-body themed-scrollbar" id="stats-body">
            <section aria-labelledby="stats-file-heading" class="stats-section">
              <h3 id="stats-file-heading">
                "Current file"
              <p class="filter-hint">
                "Nothing is playing yet."
            <section aria-labelledby="stats-library-heading" class="stats-section">
              <h3 id="stats-library-heading">
                "Library"
      <section aria-labelledby="panel-tab-filter" class="panel-page" hidden="" id="panel-page-filter" role="tabpanel">
        <div class="filter-dialog" id="filter-dialog">
          <div class="filter-dialog-header">
            <h2 id="filter-dialog-heading">
              "Preset: None"
          <div aria-label="Filter sections" class="filter-dialog-tabstrip" role="tablist">
            <button aria-selected="true" class="tab text-tab filter-tab" data-filter-tab="general" role="tab" type="button">
              "General"
            <button aria-selected="false" class="tab text-tab filter-tab" data-filter-tab="tags" role="tab" type="button">
              "Tags"
            <button aria-selected="false" class="tab text-tab filter-tab" data-filter-tab="presets" role="tab" type="button">
              "Presets"
          <div class="filter-dialog-body themed-scrollbar">
            <div class="filter-panel" id="filter-panel-general">
            <div class="filter-panel" id="filter-panel-tags" style="display: none">
            <div class="filter-panel" id="filter-panel-presets" style="display: none">
          <div class="filter-dialog-footer">
            <button aria-label="Clear all filters" class="icon-btn" disabled="" id="filter-clear-all-btn" title="Clear all filters" type="button">
              <span class="material-symbol-icon">
                "filter_alt_off"
            <button aria-label="Discard changes" class="icon-btn" disabled="" id="filter-discard-btn" title="Discard changes" type="button">
              <span class="material-symbol-icon">
                "undo"
            <button aria-label="Apply" class="held-action icon-btn" disabled="" id="filter-apply-btn" title="Apply" type="button">
              <span class="btn-label">
                <span class="material-symbol-icon">
                  "save"
              <span class="unsaved-dot" hidden="">
      <section aria-labelledby="panel-tab-randomization" class="panel-page" hidden="" id="panel-page-randomization" role="tabpanel">
        <div class="settings-tab" id="randomization-tab">
          <div class="settings-tab-header">
            <h2>
              "Randomization"
          <div class="settings-body themed-scrollbar" id="randomization-body">
            <section aria-labelledby="randomization-cycle-heading" class="stats-section">
              <details class="setting-more shortcuts-more" id="randomization-cycle" open="">
                <summary>
                  <span aria-hidden="true" class="material-symbol-icon setting-more-chevron">
                    "chevron_right"
                  <h3 id="randomization-cycle-heading">
                    "Shuffle cycle"
                <div class="cycle-body" id="randomization-cycle-body">
            <section aria-labelledby="randomization-shuffle-heading" class="settings-section">
              <h3 id="randomization-shuffle-heading">
                "Shuffle"
              <div class="setting">
                <div class="choice-row">
                  <label>
                    <input aria-describedby="randomization-shuffle-on-hint" id="randomization-shuffle-on" type="checkbox">
                    "Shuffle"
                <p class="setting-hint" id="randomization-shuffle-on-hint">
                  "Nothing repeats until everything has played, or until Remember plays for has passed."
              <div class="setting">
                <label class="setting-label" for="randomization-window">
                  "Remember plays for"
                <select class="ctl" id="randomization-window">
                  <option value="1">
                    "1 day"
                  <option value="7">
                    "7 days"
                  <option value="30">
                    "30 days"
                  <option value="90">
                    "90 days"
                  <option value="all">
                    "Until everything has played"
              <div class="setting">
                <button class="btn" id="randomization-reset" type="button">
                  "Reset now"
                <p class="setting-hint">
                  "Forgets this device's picks and starts a new cycle."
            <section aria-labelledby="randomization-spread-heading" class="settings-section">
              <h3 id="randomization-spread-heading">
                "Spread"
              <div class="setting">
                <div class="choice-row">
                  <label>
                    <input aria-describedby="randomization-spread-folder-hint" id="randomization-spread-folder" type="checkbox">
                    "Spread by folder"
                <p class="setting-hint" id="randomization-spread-folder-hint">
                  "Skips the folders of recent picks."
              <div class="setting">
                <div class="choice-row">
                  <label>
                    <input aria-describedby="randomization-spread-tags-hint" id="randomization-spread-tags" type="checkbox">
                    "Spread by tags"
                <p class="setting-hint" id="randomization-spread-tags-hint">
                  "Files that share tags with recent picks come up less, rarer tags more so."
                <fieldset class="setting-fields setting-sub" disabled="" id="randomization-tag-fields">
                  <div class="choice-stack">
                    <label>
                      <input name="randomization-tag-spread" type="radio" value="allTags">
                      <span>
                        "All tags"
                    <span class="vfield vfield-after">
                      <label>
                        <input id="randomization-by-category" name="randomization-tag-spread" type="radio" value="byCategory">
                        <span>
                          "By category"
                    <div class="setting-sub" hidden="" id="randomization-categories">
            <section aria-labelledby="randomization-favor-heading" class="settings-section">
              <h3 id="randomization-favor-heading">
                "Favor"
              <div aria-labelledby="randomization-favor-heading" class="choice-stack" role="group">
                <label>
                  <input aria-describedby="randomization-favor-favorLessPlayed-description" aria-labelledby="randomization-favor-favorLessPlayed" name="randomization-favor" type="checkbox" value="favorLessPlayed">
                  <span>
                    <span id="randomization-favor-favorLessPlayed">
                      "Less played"
                    <small id="randomization-favor-favorLessPlayed-description">
                      "Files played less, or not lately, come up more often."
                <label>
                  <input aria-describedby="randomization-favor-favorNewlyAdded-description" aria-labelledby="randomization-favor-favorNewlyAdded" name="randomization-favor" type="checkbox" value="favorNewlyAdded">
                  <span>
                    <span id="randomization-favor-favorNewlyAdded">
                      "Newly added"
                    <small id="randomization-favor-favorNewlyAdded-description">
                      "Recently added files get a share of the picks, newer ones more often."
                <label>
                  <input aria-describedby="randomization-favor-favorNewlyCreated-description" aria-labelledby="randomization-favor-favorNewlyCreated" name="randomization-favor" type="checkbox" value="favorNewlyCreated">
                  <span>
                    <span id="randomization-favor-favorNewlyCreated">
                      "Newly created"
                    <small id="randomization-favor-favorNewlyCreated-description">
                      "Recently created files get a share of the picks, newer ones more often."
                <label>
                  <input aria-describedby="randomization-favor-favorHigherRated-description" aria-labelledby="randomization-favor-favorHigherRated" name="randomization-favor" type="checkbox" value="favorHigherRated">
                  <span>
                    <span id="randomization-favor-favorHigherRated">
                      "Higher rated"
                    <small id="randomization-favor-favorHigherRated-description">
                      "Higher-rated files come up more often. An unrated file counts as 2.5 stars."
            <section aria-labelledby="randomization-behavior-section-heading" class="settings-section">
              <h3 id="randomization-behavior-section-heading">
                "Random behavior"
              <div class="setting">
                <div aria-describedby="randomization-behavior-hint" aria-labelledby="randomization-behavior-section-heading" class="choice-stack" role="radiogroup">
                  <label>
                    <input aria-describedby="randomization-behavior-jump-description" aria-labelledby="randomization-behavior-jump" name="randomization-behavior" type="radio" value="jump">
                    <span>
                      <span id="randomization-behavior-jump">
                        "Jump"
                      <small id="randomization-behavior-jump-description">
                        "Adds the pick at the end of the history."
                  <label>
                    <input aria-describedby="randomization-behavior-insert-description" aria-labelledby="randomization-behavior-insert" name="randomization-behavior" type="radio" value="insert">
                    <span>
                      <span id="randomization-behavior-insert">
                        "Insert"
                      <small id="randomization-behavior-insert-description">
                        "Puts the pick right after the current item, keeping the plays ahead after it."
                <p class="setting-hint" id="randomization-behavior-hint">
                  "For the player's Random button and R."
            <p class="setting-hint">
              "Options apply at once and are kept on this device."
      <section aria-labelledby="panel-tab-settings" class="panel-page" hidden="" id="panel-page-settings" role="tabpanel">
        <div class="settings-tab" id="settings-tab">
          <div class="settings-tab-header">
            <h2>
              "Settings"
          <div class="settings-body themed-scrollbar" id="settings-body">
            <section aria-labelledby="settings-playback-heading" class="settings-section">
              <h3 id="settings-playback-heading">
                "Playback"
              <div class="setting">
                <span class="setting-label" id="settings-autoplay-mode-label">
                  "Autoplay mode"
                <div aria-describedby="settings-autoplay-mode-hint" aria-labelledby="settings-autoplay-mode-label" class="choice-stack" role="radiogroup">
                  <label>
                    <input aria-describedby="settings-autoplay-mode-normal-description" aria-labelledby="settings-autoplay-mode-normal" name="settings-autoplay-mode" type="radio" value="normal">
                    <span>
                      <span id="settings-autoplay-mode-normal">
                        "Normal"
                      <small id="settings-autoplay-mode-normal-description">
                        "Photos advance after the timer; videos play to the end."
                  <label>
                    <input aria-describedby="settings-autoplay-mode-timer-description" aria-labelledby="settings-autoplay-mode-timer" name="settings-autoplay-mode" type="radio" value="timer">
                    <span>
                      <span id="settings-autoplay-mode-timer">
                        "Timer"
                      <small id="settings-autoplay-mode-timer-description">
                        "Every item advances after the timer. Pausing a video holds it."
                <p class="setting-hint" id="settings-autoplay-mode-hint">
                  "The player's autoplay button turns it on and off."
              <div class="setting">
                <label class="setting-label" for="settings-advance-after">
                  "Advance after"
                <div class="filter-row">
                  <span class="vfield number-field">
                    <input autocomplete="off" class="ctl" id="settings-advance-after" inputmode="numeric" type="text">
                    <span aria-live="polite" class="visually-hidden">
                  <span>
                    "seconds"
              <div class="setting">
                <div class="choice-row">
                  <label>
                    <input aria-describedby="settings-loop-stops-autoplay-hint" id="settings-loop-stops-autoplay" type="checkbox">
                    "Loop stops autoplay"
                <p class="setting-hint" id="settings-loop-stops-autoplay-hint">
                  "With Autoplay and Loop on, the item repeats and nothing advances. Turned off, autoplay goes on, and a video shorter than Advance after repeats until it advances."
              <div class="setting">
                <span class="setting-label" id="settings-seek-step-label">
                  "Seek step"
                <div aria-labelledby="settings-seek-step-label" class="choice-row" role="radiogroup">
                  <label>
                    <input aria-labelledby="settings-seek-step-1" name="settings-seek-step" type="radio" value="1">
                    <span>
                      <span id="settings-seek-step-1">
                        "1 second"
                  <label>
                    <input aria-labelledby="settings-seek-step-5" name="settings-seek-step" type="radio" value="5">
                    <span>
                      <span id="settings-seek-step-5">
                        "5 seconds"
                  <label>
                    <input aria-labelledby="settings-seek-step-10" name="settings-seek-step" type="radio" value="10">
                    <span>
                      <span id="settings-seek-step-10">
                        "10 seconds"
            <section aria-labelledby="settings-audio-heading" class="settings-section">
              <h3 id="settings-audio-heading">
                "Audio"
              <div class="setting">
                <span class="setting-label" id="settings-volume-step-label">
                  "Volume step"
                <div aria-describedby="settings-volume-step-hint" aria-labelledby="settings-volume-step-label" class="choice-row" role="radiogroup">
                  <label>
                    <input aria-labelledby="settings-volume-step-1" name="settings-volume-step" type="radio" value="1">
                    <span>
                      <span id="settings-volume-step-1">
                        "1%"
                  <label>
                    <input aria-labelledby="settings-volume-step-2" name="settings-volume-step" type="radio" value="2">
                    <span>
                      <span id="settings-volume-step-2">
                        "2%"
