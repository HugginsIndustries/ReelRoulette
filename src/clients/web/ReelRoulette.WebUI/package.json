{
  "name": "reelroulette-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:icon": "node ./scripts/sync-shared-icon.mjs",
    "predev": "npm run sync:icon",
    "prebuild": "npm run sync:icon",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:contracts": "openapi-typescript ../../../../shared/api/openapi.yaml -o ./src/types/openapi.generated.ts",
    "verify:contracts": "node ./scripts/verify-openapi-contracts-fresh.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json",
    "verify:app-js-names": "node ./scripts/verify-app-js-names.mjs",
    "test": "vitest run",
    "verify:build-output": "node ./scripts/verify-build-output.mjs",
    "verify": "npm run verify:contracts && npm run typecheck && npm run verify:app-js-names && npm run test && npm run build && npm run verify:build-output"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "openapi-typescript": "^7.13.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "brace-expansion": "^5.0.12",
    "minimatch": "^10.2.5"
  }
}
